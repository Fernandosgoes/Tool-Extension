{
  "manifest_version": 3,
  "name": "Snov.io Support Tools",
  "version": "1.0.0",
  "description": "Internal tool for Snov.io support agents — send confirmation links and Fastspring requests via webhook.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://hook.us1.make.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icons top right/Extension icon/ei24.png",
      "32": "icons/icons top right/Extension icon/ei64.png",
      "48": "icons/icons top right/Extension icon/ei64.png",
      "128": "icons/icons top right/Extension icon/ei128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icons top right/Extension icon/ei24.png",
    "32": "icons/icons top right/Extension icon/ei64.png",
    "48": "icons/icons top right/Extension icon/ei64.png",
    "128": "icons/icons top right/Extension icon/ei128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
